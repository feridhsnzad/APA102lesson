@using FrontToBack.Areas.AdminPanel.ViewModels
@model List<GetCategoryVM>
@{
    int count = 0;
}
<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Category Table</h4>
                <div class="table-responsive">
                    <a asp-action="create" class="btn btn-success">Create</a>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>
                                    No№
                                </th>
                                <th>
                                    Name
                                </th>
                                <th>
                                    Products Count
                                </th>
                                <th>
                                    Settings
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (GetCategoryVM getCategoryVM in Model)
                            {
                                count++;
                                <tr>
                                    <td>
                                        <p>@count</p>
                                    </td>
                                    <td>
                                        <p>@getCategoryVM.Name</p>
                                    </td>
                                    <td>
                                        <p>@getCategoryVM.ProductCount</p>
                                    </td>
                                    <td>
                                        <a class="btn btn-warning" asp-action="update" asp-route-id="@getCategoryVM.Id"><i class="mdi mdi-border-color"></i></a>
                                        <a class="btn btn-danger" asp-action="delete" asp-route-id="@getCategoryVM.Id"><i class="mdi mdi-delete-forever"></i></a>
                                        <a class="btn btn-primary" asp-action="details" asp-route-id="@getCategoryVM.Id"><i class="mdi mdi-information"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>