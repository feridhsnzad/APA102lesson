@using FrontToBack.Areas.AdminPanel.ViewModels
@model DetailsCategoryVM

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Details Table</h4>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>
                                    No№
                                </th>
                                <th>
                                    Name
                                </th>
                                <th>
                                    Products Count
                                </th>
                                <th>
                                    Created At
                                </th>
                                <th>
                                    Settings
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                                <tr>
                                    <td>
                                        <p>@Model.Id</p>
                                    </td>
                                    <td>
                                        <p>@Model.Name</p>
                                    </td>
                                    <td>
                                        <p>@Model.ProductCount</p>
                                    </td>
                                    <td>
                                        <p>@Model.CreatedAt</p>
                                    </td>
                                    <td>
                                        <a asp-action="index" class="btn btn-primary"> Back</a>
                                    </td>
                                </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>